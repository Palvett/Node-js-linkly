{
  "name": "linkly",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:migrate:test": "NODE_ENV=test node src/db/migrate.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check \"src/**/*.js\"",
    "pretest": "npm run db:migrate:test",
    "db:seed": "node src/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
